<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.smartmeal</groupId>
        <artifactId>smartmeal-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>smartmeal-app-api</artifactId>
    <name>smartmeal-app-api</name>
    <description>用户端接口层：可执行启动模块，端口 8080</description>

    <dependencies>
        <dependency>
            <groupId>com.smartmeal</groupId>
            <artifactId>smartmeal-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>com.smartmeal</groupId>
            <artifactId>smartmeal-job</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>
        <!--
            Knife4j 只提供 UI 层，OpenAPI 的模型与注解（io.swagger.v3.oas.models.*）
            来自 springdoc。父 POM 里已经把 Knife4j 自带的旧版 springdoc 排除掉，
            这里必须显式引入对齐到 Boot 3.5 的版本，否则编译期就找不到 OpenAPI 类。
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
