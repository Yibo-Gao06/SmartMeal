# 仓库内统一 LF，检出也默认 LF
* text=auto eol=lf

# Windows 批处理必须 CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# 二进制文件禁止行尾转换
*.jar   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary

# 免得被算进语言统计
mvnw     linguist-vendored
mvnw.cmd linguist-vendored

# 生成的 sql 脚本保持 LF
*.sql text eol=lf
