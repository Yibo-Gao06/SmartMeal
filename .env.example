# ===== SmartMeal 环境变量模板 =====
# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，不会进仓库。

# --- DeepSeek 大模型 ---
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 数据库 ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=smartmeal
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_password

# --- Redis（本机未安装时留空，应用会自动降级为本地 Caffeine 缓存）---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
