<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.smartmeal</groupId>
        <artifactId>smartmeal-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>smartmeal-service</artifactId>
    <name>smartmeal-service</name>
    <description>业务服务层：用户 / 食材 / 菜谱 / 商品 / 购物车 / 订单 / 支付 / 知识库</description>

    <dependencies>
        <dependency>
            <groupId>com.smartmeal</groupId>
            <artifactId>smartmeal-repository</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            只引 spring-security-crypto，不引 spring-boot-starter-security。
            这里要的只是 BCryptPasswordEncoder 这一个类，而 starter-security 会顺带拉起
            整条过滤器链，默认给所有接口套上 HTTP Basic 和 CSRF ——
            本项目的鉴权是 Sa-Token 负责的，两套机制叠在一起只会互相打架
            （典型症状是登录接口突然 401，或者 POST 全部 403）。
            版本由 Spring Boot 的 BOM 管，不写死。
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            测试依赖。注意 test 作用域不会沿模块依赖传递，
            所以每个要写测试的模块都得自己引一次，不能指望从 smartmeal-common 继承。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
